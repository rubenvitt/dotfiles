#!/bin/bash
# JankyBorders — farbiger Rahmen um das fokussierte Fenster.
# Doku: man borders
#
# Symlink: ~/.config/borders/bordersrc -> ~/.dotfiles/borders/bordersrc
# Autostart: mbar.app führt diese Datei beim Start selbst aus
#
# Farben folgen dem Sketchybar-Schema (sketchybar/colors.lua):
#   orange 0xfff39660 (aktiv), bg2 0xff414550 (inaktiv)

options=(
    style=round
    width=6.0
    hidpi=on
    active_color=0xfff39660
    inactive_color=0xff414550
)

borders "${options[@]}"
