[include]
	path = ~/.config/git/base.gitconfig

[core]
	autocrlf = input
[commit]
	gpgsign = true
[gpg]
	program = /usr/local/bin/gpg
[init]
	defaultBranch = main

[core]
	pager = delta
	fsmonitor = true
	editor = zed -w


# settings for git-delta
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    side-by-side = true
    hyperlinks = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[pager]
    blame = true
[credential]
	helper = osxkeychain
[clone]
	defaultRemoteName = origin
[user]
	name = Ruben Vitt
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[maintenance]
	repo = /Users/rubeen/.zsh/plugins/zsh-autocomplete
[advice]
	addIgnoredFile = false
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

# Die bedingten Includes stehen bewusst am Dateiende: Git wertet von oben nach
# unten aus, spätere Werte gewinnen. Nur hier unten können sie die globalen
# Vorgaben weiter oben (etwa commit.gpgsign) tatsächlich überschreiben.
[includeIf "gitdir:~/dev/work/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:~/wnotes/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:~/dev/work/innoq/"]
	path = ~/.config/git/innoq.gitconfig
[includeIf "gitdir:~/.dotfiles/"]
        path = ~/.config/git/personal.gitconfig
[includeIf "gitdir:~/dev/personal/"]
	path = ~/.config/git/personal.gitconfig
[includeIf "gitdir:~/dev/edu/"]
        path = ~/.config/git/personal.gitconfig
[includeIf "gitdir:~/dev/dearinnovation/"]
        path = ~/.config/git/dearinnovation.gitconfig
[includeIf "gitdir:~.codex/worktrees/"]
		path = ~/.config/git/personal.gitconfig
