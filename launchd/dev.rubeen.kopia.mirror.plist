<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.rubeen.kopia.mirror</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rubeen/.dotfiles/launchd/kopia-mirror.sh</string>
    </array>
    <!-- Netzteil und Kabel lösen kein launchd-Ereignis aus; das Intervall
         fängt beide ab, StartOnMount reagiert sofort auf die Platte. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StartOnMount</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/rubeen/Library/Logs/kopia/mirror.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rubeen/Library/Logs/kopia/mirror.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/rubeen</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin</string>
    </dict>
</dict>
</plist>
