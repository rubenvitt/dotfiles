#!/usr/bin/env bash
# apager - aPager-Alarme aus dem Tailnet auf dem Mac anzeigen
set -euo pipefail

# Warum es dieses Skript gibt: aPager PRO setzt den Webhook vom Handy ab, nicht
# von einem Server. Der Mac braucht deshalb keine oeffentliche Erreichbarkeit —
# ein Listener, der ausschliesslich an die Tailscale-Adresse bindet, genuegt.
#
# Der Mac ist Anzeige, nicht Alarmierung: kein Ton, keine Benachrichtigung,
# kein Wecken. Schlaeft er, verpasst er den Alarm. Alarmiert wird ueber das
# Handy. Siehe docs/2026-09-10-apager-design.md.

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)"
LISTENER="$TOOLS_DIR/apager-listener.py"

LABEL="email.rubeen.apager"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SERVICE="gui/$(id -u)/$LABEL"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/apager"
CONFIG="$CONFIG_DIR/config"
STATE_DIR="$HOME/.local/state/apager"
ALARM_LOG="$STATE_DIR/alarms.log"
LISTENER_LOG="$STATE_DIR/listener.log"
BOUND="$STATE_DIR/bound"

# Absolut, weil launchd einen minimalen PATH setzt und dieses Skript die plist
# schreibt, die davon abhaengt.
PYTHON="/usr/bin/python3"

usage() {
  cat <<'EOF'
apager - aPager-Alarme aus dem Tailnet auf dem Mac anzeigen

  apager install      Config und LaunchAgent anlegen, Listener starten
  apager uninstall    LaunchAgent entfernen (Config und Protokolle bleiben)
  apager status       Laeuft der Agent, woran haengt er, wann kam der letzte Alarm
  apager url          Die URL, die in aPager einzutragen ist
  apager test         Einen Testalarm ueber das Tailnet schicken
  apager logs         Die letzten Alarme anzeigen
  apager logs -f      Dem Protokoll folgen
  apager logs --listener   Betriebsmeldungen des Listeners anzeigen
  apager -h | --help  Diese Hilfe

Zwei Protokolle, und sie beantworten verschiedene Fragen:
  alarms.log    was angekommen ist            ("apager logs")
  listener.log  was abgewiesen wurde und      ("apager logs --listener")
                warum der Listener nicht bindet

Ein Alarm, der wegen eines veralteten Tokens mit 404 abprallt, steht nur im
listener.log — "apager status" zaehlt solche Faelle deshalb mit.

Der Mac ist Anzeige, nicht Alarmierung: kein Ton, keine Benachrichtigung, kein
Wecken. Schlaeft der Rechner, verpasst er den Alarm — alarmiert wird ueber das
Handy.
EOF
}

die() { printf 'apager: %s\n' "$1" >&2; exit 1; }

# --- Zustand abfragen --------------------------------------------------------

config_value() {
  [[ -f "$CONFIG" ]] || return 1
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\{0,1\}\([^\"]*\)\"\{0,1\}[[:space:]]*$/\1/p" "$CONFIG" | head -1
}

# Die tatsaechlich gebundene Adresse, nicht die konfigurierte. Genau darin liegt
# der Unterschied zwischen "sollte laufen" und "laeuft".
bound_address() { [[ -f "$BOUND" ]] && cat "$BOUND" || true; }

# Ob am Eintrag in $BOUND wirklich etwas horcht. Der Listener loescht die Datei
# bei SIGTERM und beim Start, aber ein harter Absturz (kill -9, Systemschlaf,
# was auch immer) kann eine Datei zuruecklassen, die eine tote Adresse
# beschreibt. "status" darf das nicht als "gebunden" vorlesen — genau dann,
# wenn jemand nachsieht, ob ein Alarm ankommen wuerde, waere das die Luege,
# die am meisten schadet.
#
# /dev/tcp ist eine Bash-eigene Umleitung, kein externes Programm: kein nc,
# kein curl noetig, nur ein Verbindungsversuch mit Timeout. Ein abgelehnter
# oder haengender Connect darf das Skript unter "set -e" nicht beenden,
# deshalb steht der Aufruf immer in einer Bedingung.
#
# "timeout" gibt es auf einem frischen macOS nicht, nur ueber Homebrews
# coreutils. Ohne es faellt die Pruefung auf einen Connect ohne Zeitschranke
# zurueck: jede Adresse hier ist die eigene Maschine, der Kernel antwortet
# also sofort mit ACK, RST oder EHOSTUNREACH — der Timeout war ohnehin nur
# ein Guertel, nicht die Hose.
# Abgewiesene Anfragen stehen ausschliesslich im listener.log. Ohne diese
# Auswertung meldet "status" bei einem veralteten Token vier gruene Zeilen —
# Agent geladen, Listener gebunden, Tailscale verbunden, noch kein Alarm —
# waehrend jeder echte Alarm mit 404 abprallt. Genau die Anzeige, die Gesundheit
# behauptet, wo keine ist.
#
# Gezaehlt wird ab dem letzten "gebunden an": in einem Protokoll, das niemand
# rotiert, laese die Zeile sonst fuer immer "47 seit August" und beantwortete
# nicht mehr die Frage, um die es geht — prallt gerade jetzt etwas ab.
#
# Der Pfad bleibt draussen, dort steht das versuchte Token. awk statt einer
# grep-Kette, weil es in einem Durchlauf zaehlt und unter "set -o pipefail"
# auch ohne Treffer mit 0 endet.
rejection_summary() {
  [[ -s "$LISTENER_LOG" ]] || return 0
  awk '
    /gebunden an/          { n = 0; first = ""; last = ""; next }
    /abgewiesen: /         {
      n++
      if (first == "") first = substr($0, 1, 16)
      last = $0
      sub(/.*abgewiesen: /, "", last)
      sub(/ \([^(]*\)$/, "", last)
    }
    END { if (n > 0) printf "%d seit %s (letzte: %s)", n, first, last }
  ' "$LISTENER_LOG"
}

# Die letzte Zeile des listener.log — ohne Heuristik, und gerade deshalb
# aussagekraeftig: haengt der Listener an keiner Adresse, unterscheidet genau
# diese Zeile "keine Tailscale-Adresse — warte" von einer Absturzschleife
# (fehlendes Token, unbrauchbarer Port), die KeepAlive alle zehn Sekunden neu
# startet. Beide Faelle sahen bisher identisch aus.
listener_last_line() {
  [[ -s "$LISTENER_LOG" ]] || return 0
  tail -1 "$LISTENER_LOG"
}

# Die eigene Tailscale-Adresse, mit denselben zwei Bedingungen wie im Listener:
# utun-Interface und der echte Bereich 100.64.0.0/10. Ein blosses "inet 100."
# traefe 100.0.0.0/8 und damit weit mehr, als Tailscale je vergibt.
tailscale_address() {
  /sbin/ifconfig -a 2>/dev/null | awk '
    /^[^[:space:]]/ { iface = $1; sub(/:$/, "", iface); next }
    $1 == "inet" && iface ~ /^utun/ {
      split($2, o, ".")
      if (o[1] == 100 && o[2] >= 64 && o[2] <= 127) { print $2; exit }
    }
  ' || true
}

listener_alive() {
  local addr="$1"
  if command -v timeout >/dev/null 2>&1; then
    timeout 2 bash -c "echo > /dev/tcp/${addr%:*}/${addr##*:}" 2>/dev/null
  else
    bash -c "echo > /dev/tcp/${addr%:*}/${addr##*:}" 2>/dev/null
  fi
}

# --- Aktionen ----------------------------------------------------------------

do_install() {
  [[ -f "$LISTENER" ]] || die "apager-listener.py fehlt neben $0"

  mkdir -p "$CONFIG_DIR" "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  if [[ -f "$CONFIG" ]]; then
    printf 'Config bleibt: %s\n' "$CONFIG"
  else
    local token
    token="$(openssl rand -hex 16)"
    # umask in einer Subshell: sonst erbte die plist weiter unten sie und
    # bekaeme bei einer Neuinstallation eine andere Zugriffsmaske als bei der
    # ersten. Das chmod deckt den kurzen Moment zwischen Anlegen und Setzen ab.
    (
      umask 077
      cat > "$CONFIG" <<CONF
# Von \`apager install\` erzeugt. Siehe docs/apager.conf.example.
APAGER_PORT="8787"
APAGER_TOKEN="$token"
CONF
    )
    chmod 600 "$CONFIG"
    printf 'Config angelegt: %s\n' "$CONFIG"
  fi

  # launchd oeffnet die listener.log selbst und mit seiner eigenen umask (644).
  # Die umask des Listeners kommt dafuer zu spaet — die Datei existiert dann
  # schon. Sie enthaelt die abgewiesenen Pfade und damit versuchte Token,
  # deshalb hier anlegen, bevor launchd sie zum ersten Mal oeffnet.
  : >> "$LISTENER_LOG"
  chmod 600 "$LISTENER_LOG"
  # Einsatzadressen, mitunter Namen. Bestandsdateien einer aelteren Fassung
  # tragen noch 644.
  if [[ -f "$ALARM_LOG" ]]; then chmod 600 "$ALARM_LOG"; fi

  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$PYTHON</string>
		<string>$LISTENER</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>$LISTENER_LOG</string>
	<key>StandardErrorPath</key>
	<string>$LISTENER_LOG</string>
</dict>
</plist>
PLIST_EOF

  # bootout vor bootstrap: eine bereits geladene Fassung wuerde die neue
  # sonst mit "service already loaded" abweisen.
  launchctl bootout "$SERVICE" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  printf 'LaunchAgent geladen: %s\n\n' "$LABEL"

  do_url
}

do_uninstall() {
  launchctl bootout "$SERVICE" 2>/dev/null || true
  rm -f "$PLIST"
  printf 'LaunchAgent entfernt. Config und Protokolle bleiben:\n  %s\n  %s\n' \
    "$CONFIG" "$ALARM_LOG"
}

do_url() {
  local token port bound
  token="$(config_value APAGER_TOKEN)" || die "keine Config — erst 'apager install'"
  [[ -n "$token" ]] || die "APAGER_TOKEN fehlt in $CONFIG"
  port="$(config_value APAGER_PORT)"
  bound="$(bound_address)"

  if [[ -n "$bound" ]] && listener_alive "$bound"; then
    printf 'In aPager als Ziel eintragen:\n\n  http://%s/alarm/%s\n\n' "$bound" "$token"
  else
    if [[ -n "$bound" ]]; then
      printf 'Veraltete Datei: sie nennt %s, aber dort antwortet niemand.\n' "$bound"
    else
      printf 'Der Listener haengt gerade an keiner Adresse (Tailscale aus?).\n'
    fi
    printf 'Sobald er gebunden ist, lautet die URL:\n\n  http://<tailscale-adresse>:%s/alarm/%s\n\n' \
      "$port" "$token"
  fi
  printf 'Das Token ist ein Geheimnis: Wer die URL hat, kann Alarme einspeisen.\n'
}

do_status() {
  local bound

  if launchctl print "$SERVICE" >/dev/null 2>&1; then
    printf 'LaunchAgent   geladen (%s)\n' "$LABEL"
  else
    printf 'LaunchAgent   NICHT geladen — "apager install" fehlt\n'
  fi

  bound="$(bound_address)"
  if [[ -z "$bound" ]]; then
    printf 'Listener      an keine Adresse gebunden\n'
    local why
    why="$(listener_last_line)"
    if [[ -n "$why" ]]; then
      printf '              zuletzt im Protokoll: %s\n' "$why"
    fi
  elif listener_alive "$bound"; then
    printf 'Listener      gebunden an %s\n' "$bound"
  else
    printf 'Listener      veraltete Datei (%s) — es antwortet niemand\n' "$bound"
  fi

  # Ueber ifconfig statt ueber das tailscale-CLI: der App-Store-Build blockiert
  # dessen Aufrufe gelegentlich minutenlang.
  local ts
  ts="$(tailscale_address)"
  if [[ -n "$ts" ]]; then
    printf 'Tailscale     verbunden (%s)\n' "$ts"
  else
    printf 'Tailscale     keine Adresse — es kommt nichts an\n'
  fi

  if [[ -s "$ALARM_LOG" ]]; then
    local last
    # Kein Treffer ist kein Skriptabbruch wert: eine Datei mit Inhalt, aber
    # ohne passende Zeile (abgebrochener Schreibvorgang, verirrte Zeile vor
    # dem ersten Block), ist ein Anzeigefall, kein Fehlerfall.
    last="$(grep -a '^===== ' "$ALARM_LOG" | tail -1 | tr -d '= ')" || true
    if [[ -n "$last" ]]; then
      printf 'Letzter Alarm %s\n' "$last"
    else
      printf 'Letzter Alarm kein passender Eintrag im Protokoll\n'
    fi
  else
    printf 'Letzter Alarm noch keiner\n'
  fi

  local rejected
  rejected="$(rejection_summary)"
  if [[ -n "$rejected" ]]; then
    printf 'Abgewiesen    %s\n' "$rejected"
  elif [[ -f "$LISTENER_LOG" ]]; then
    printf 'Abgewiesen    keine\n'
  else
    printf 'Abgewiesen    kein Protokoll (%s)\n' "$LISTENER_LOG"
  fi
}

do_test() {
  local bound token
  bound="$(bound_address)"
  [[ -n "$bound" ]] || die "der Listener haengt an keiner Adresse — 'apager status' zeigt warum"
  listener_alive "$bound" \
    || die "veraltete Datei ($bound) — der Listener antwortet nicht, 'apager status' zeigt warum"
  token="$(config_value APAGER_TOKEN)" || die "keine Config — erst 'apager install'"
  [[ -n "$token" ]] || die "APAGER_TOKEN fehlt in $CONFIG"

  # Bewusst an die gebundene Tailscale-Adresse und nicht an 127.0.0.1: nur so
  # laufen Bind, Herkunftspruefung und Tokenvergleich wirklich mit. Ueber
  # Loopback waere der Test gruen, waehrend genau diese drei kaputt sind.
  local body
  body="TESTALARM $(date '+%H:%M:%S')
Musterstrasse 12, Musterstadt
Ausgeloest von: apager test"

  printf 'Sende an http://%s/alarm/...\n' "$bound"
  # -K - liest die URL (und damit das Token) aus einem Config-Stream auf
  # stdin statt als Kommandozeilenargument: als Argument stuende es fuer die
  # Laufzeit des Aufrufs in "ps" sichtbar fuer jeden Prozess auf der Maschine
  # — genau das verbietet CLAUDE.md fuer Geheimnisse.
  curl -fsS --max-time 5 -X POST --data-binary "$body" -K - >/dev/null <<CURLCFG \
    || die "der Listener hat nicht angenommen — 'apager logs' und $LISTENER_LOG ansehen"
url = "http://$bound/alarm/$token"
CURLCFG
  printf 'Angenommen. Der Dialog sollte jetzt offen sein.\n'
}

# Zwei Protokolle, zwei Fragen: alarms.log sagt, was ankam, listener.log sagt,
# was abgewiesen wurde und warum nicht gebunden wird. Letzteres war bisher von
# keinem Befehl erreichbar.
do_logs() {
  local log="$ALARM_LOG" follow=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      --listener)  log="$LISTENER_LOG" ;;
      "")          ;;
      *)           die "unbekannte Option fuer logs: $1 (siehe --help)" ;;
    esac
    shift
  done

  [[ -f "$log" ]] || die "noch kein Protokoll: $log"
  if [[ -n "$follow" ]]; then
    tail -f "$log"
  else
    tail -40 "$log"
  fi
}

case "${1:-}" in
  -h|--help|help) usage ;;
  install)        do_install ;;
  uninstall)      do_uninstall ;;
  status)         do_status ;;
  url)            do_url ;;
  test)           do_test ;;
  logs)           shift; do_logs "$@" ;;
  "")             do_status ;;
  *)              die "unbekannter Befehl: $1 (siehe --help)" ;;
esac
