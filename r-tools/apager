#!/usr/bin/env bash
# apager - aPager-Alarme ueber Tailscale Serve auf dem Mac anzeigen
set -euo pipefail

# Warum es dieses Skript gibt: aPager PRO setzt den Webhook vom Handy ab, nicht
# von einem Server. Der Mac braucht deshalb keine oeffentliche Erreichbarkeit —
# aber er braucht HTTPS. iOS App Transport Security laesst "http://" gar nicht
# erst zu; aPager scheitert daran vor jedem Verbindungsversuch
# (NSURLErrorDomain Code=-1022).
#
# Deshalb steht Tailscale Serve vor dem Listener: es terminiert HTTPS mit dem
# echten *.ts.net-Zertifikat, laesst nur authentifizierte Tailnet-Gegenstellen
# herein und leitet nach 127.0.0.1 weiter. Nur Serve, nie Funnel — Funnel
# stellte den Alarmendpunkt ins oeffentliche Internet.
#
# Der Mac ist Anzeige, nicht Alarmierung: kein Ton, keine Benachrichtigung,
# kein Wecken. Schlaeft er, verpasst er den Alarm. Alarmiert wird ueber das
# Handy. Siehe docs/2026-09-10-apager-design.md.

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)"
LISTENER="$TOOLS_DIR/apager-listener.py"

LABEL="email.rubeen.apager"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SERVICE="gui/$(id -u)/$LABEL"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/apager"
CONFIG="$CONFIG_DIR/config"
STATE_DIR="$HOME/.local/state/apager"
ALARM_LOG="$STATE_DIR/alarms.log"
LISTENER_LOG="$STATE_DIR/listener.log"
BOUND="$STATE_DIR/bound"

# Absolut, weil launchd einen minimalen PATH setzt und dieses Skript die plist
# schreibt, die davon abhaengt.
PYTHON="/usr/bin/python3"

# Der Shim der Tailscale-App. Homebrews /opt/homebrew/bin/tailscale existiert
# hier ebenfalls, zeigt aber auf eine eigene Version und warnt bei jedem Aufruf
# ueber einen Client/Daemon-Versionsunterschied.
TAILSCALE="/usr/local/bin/tailscale"

# Wohin Serve weiterleitet und woran der Listener horcht. Nicht die eigene
# Tailnet-Adresse des Knotens: dorthin weitergeleiteter Verkehr laeuft zurueck
# durch den Tailscale-Stack und blockiert. Gemessen auf diesem Rechner —
# Loopback-Backend 200 in 25 ms, eigenes Tailnet-Backend Timeout nach 20 s.
LISTEN_ADDRESS="127.0.0.1"
DEFAULT_PORT="8787"

# Der Pfad, ueber den "status" die ganze Kette prueft. Er braucht kein Token
# und der Listener beantwortet ihn mit 204, ohne eine Zeile zu schreiben —
# sonst zaehlte jede Statusabfrage als abgewiesene Anfrage und verdaerbe genau
# die Zahl, an der ein veraltetes Token auffliegt.
HEALTH_PATH="/healthz"

usage() {
  cat <<'EOF'
apager - aPager-Alarme ueber Tailscale Serve auf dem Mac anzeigen

  apager install      Config, LaunchAgent und Tailscale Serve einrichten
  apager uninstall    LaunchAgent und Serve entfernen (Config und Protokolle bleiben)
  apager status       Laeuft der Agent, kommt HTTPS durch, wann kam der letzte Alarm
  apager url          Die HTTPS-URL, die in aPager einzutragen ist
  apager test         Einen Testalarm ueber HTTPS durch Serve schicken
  apager logs         Die letzten Alarme anzeigen
  apager logs -f      Dem Protokoll folgen
  apager logs --listener   Betriebsmeldungen des Listeners anzeigen
  apager -h | --help  Diese Hilfe

Zwei Protokolle, und sie beantworten verschiedene Fragen:
  alarms.log    was angekommen ist            ("apager logs")
  listener.log  was abgewiesen wurde und      ("apager logs --listener")
                warum der Listener nicht bindet

Ein Alarm, der wegen eines veralteten Tokens mit 404 abprallt, steht nur im
listener.log — "apager status" zaehlt solche Faelle deshalb mit.

Der Endpunkt ist HTTPS, und das ist keine Wahl: iOS App Transport Security
laesst "http://" nicht zu. Tailscale Serve terminiert TLS und leitet nach
127.0.0.1 weiter — nur im Tailnet, nie per Funnel.

Der Mac ist Anzeige, nicht Alarmierung: kein Ton, keine Benachrichtigung, kein
Wecken. Schlaeft der Rechner, verpasst er den Alarm — alarmiert wird ueber das
Handy.
EOF
}

die() { printf 'apager: %s\n' "$1" >&2; exit 1; }

# --- Zustand abfragen --------------------------------------------------------

config_value() {
  [[ -f "$CONFIG" ]] || return 1
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\{0,1\}\([^\"]*\)\"\{0,1\}[[:space:]]*$/\1/p" "$CONFIG" | head -1
}

# Die tatsaechlich gebundene Adresse, nicht die konfigurierte. Genau darin liegt
# der Unterschied zwischen "sollte laufen" und "laeuft".
bound_address() { [[ -f "$BOUND" ]] && cat "$BOUND" || true; }

# Ob am Eintrag in $BOUND wirklich etwas horcht. Der Listener loescht die Datei
# bei SIGTERM und beim Start, aber ein harter Absturz (kill -9, Systemschlaf,
# was auch immer) kann eine Datei zuruecklassen, die eine tote Adresse
# beschreibt. "status" darf das nicht als "gebunden" vorlesen — genau dann,
# wenn jemand nachsieht, ob ein Alarm ankommen wuerde, waere das die Luege,
# die am meisten schadet.
#
# /dev/tcp ist eine Bash-eigene Umleitung, kein externes Programm: kein nc,
# kein curl noetig, nur ein Verbindungsversuch mit Timeout. Ein abgelehnter
# oder haengender Connect darf das Skript unter "set -e" nicht beenden,
# deshalb steht der Aufruf immer in einer Bedingung.
#
# "timeout" gibt es auf einem frischen macOS nicht, nur ueber Homebrews
# coreutils. Ohne es faellt die Pruefung auf einen Connect ohne Zeitschranke
# zurueck: jede Adresse hier ist die eigene Maschine, der Kernel antwortet
# also sofort mit ACK, RST oder EHOSTUNREACH — der Timeout war ohnehin nur
# ein Guertel, nicht die Hose.
# Abgewiesene Anfragen stehen ausschliesslich im listener.log. Ohne diese
# Auswertung meldet "status" bei einem veralteten Token vier gruene Zeilen —
# Agent geladen, Listener gebunden, Tailscale verbunden, noch kein Alarm —
# waehrend jeder echte Alarm mit 404 abprallt. Genau die Anzeige, die Gesundheit
# behauptet, wo keine ist.
#
# Gezaehlt wird ab dem letzten "gebunden an": in einem Protokoll, das niemand
# rotiert, laese die Zeile sonst fuer immer "47 seit August" und beantwortete
# nicht mehr die Frage, um die es geht — prallt gerade jetzt etwas ab.
#
# Der Pfad bleibt draussen, dort steht das versuchte Token. awk statt einer
# grep-Kette, weil es in einem Durchlauf zaehlt und unter "set -o pipefail"
# auch ohne Treffer mit 0 endet.
rejection_summary() {
  [[ -s "$LISTENER_LOG" ]] || return 0
  awk '
    /gebunden an/          { n = 0; first = ""; last = ""; next }
    /abgewiesen: /         {
      n++
      if (first == "") first = substr($0, 1, 16)
      last = $0
      sub(/.*abgewiesen: /, "", last)
      sub(/ \([^(]*\)$/, "", last)
    }
    END { if (n > 0) printf "%d seit %s (letzte: %s)", n, first, last }
  ' "$LISTENER_LOG"
}

# Die letzte Zeile des listener.log — ohne Heuristik, und gerade deshalb
# aussagekraeftig: haengt der Listener an keiner Adresse, unterscheidet genau
# diese Zeile "keine Tailscale-Adresse — warte" von einer Absturzschleife
# (fehlendes Token, unbrauchbarer Port), die KeepAlive alle zehn Sekunden neu
# startet. Beide Faelle sahen bisher identisch aus.
listener_last_line() {
  [[ -s "$LISTENER_LOG" ]] || return 0
  tail -1 "$LISTENER_LOG"
}

# Die eigene Tailscale-Adresse. Der Listener kennt sie nicht mehr — er bindet
# auf Loopback —, aber "status" braucht sie weiterhin: sie unterscheidet, warum
# die HTTPS-Pruefung rot ist. Tailscale unten, Serve falsch eingerichtet oder
# Listener tot sehen sonst gleich aus.
#
# Ueber ifconfig statt ueber das CLI, weil es hier auf eine billige, nie
# blockierende lokale Auskunft ankommt. Zwei Bedingungen: utun-Interface und
# der echte Bereich 100.64.0.0/10. Ein blosses "inet 100." traefe 100.0.0.0/8
# und damit weit mehr, als Tailscale je vergibt; die Interface-Bedingung haelt
# die CGNAT-Adresse heraus, die ein per Mobilfunk getethertes en0 traegt.
tailscale_address() {
  /sbin/ifconfig -a 2>/dev/null | awk '
    /^[^[:space:]]/ { iface = $1; sub(/:$/, "", iface); next }
    $1 == "inet" && iface ~ /^utun/ {
      split($2, o, ".")
      if (o[1] == 100 && o[2] >= 64 && o[2] <= 127) { print $2; exit }
    }
  ' || true
}

listener_alive() {
  local addr="$1"
  if command -v timeout >/dev/null 2>&1; then
    timeout 2 bash -c "echo > /dev/tcp/${addr%:*}/${addr##*:}" 2>/dev/null
  else
    bash -c "echo > /dev/tcp/${addr%:*}/${addr##*:}" 2>/dev/null
  fi
}

# --- Tailscale abfragen ------------------------------------------------------

# Jeder Aufruf des tailscale-CLI laeuft hier durch, und zwar mit Zeitschranke:
# der App-Store-Build blockiert Aufrufe gelegentlich minutenlang. Ohne Schranke
# haengt "apager status" genau dann, wenn jemand wissen will, ob ein Alarm
# ankaeme. Fehlt "timeout" (frisches macOS ohne coreutils), laeuft der Aufruf
# ungebremst — schlechter als mit, aber immer noch eine Auskunft.
#
# Rueckgabe 127 heisst "kein CLI da". Die Aufrufer machen daraus "unbekannt"
# und nie "nicht eingerichtet": eine Frage, die nicht gestellt werden konnte,
# darf nicht als beantwortet erscheinen.
tailscale_cli() {
  [[ -x "$TAILSCALE" ]] || return 127
  if command -v timeout >/dev/null 2>&1; then
    timeout 10 "$TAILSCALE" "$@" 2>/dev/null
  else
    "$TAILSCALE" "$@" 2>/dev/null
  fi
}

# Der eigene MagicDNS-Name, ohne den Punkt am Ende. Er steht nirgends in diesem
# Repo: .dotfiles ist oeffentlich, der Tailnet-Name gehoert nicht hinein — also
# wird er zur Laufzeit erfragt.
tailscale_dns_name() {
  tailscale_cli status --json | "$PYTHON" -c '
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    raise SystemExit(1)
name = (data.get("Self") or {}).get("DNSName", "").rstrip(".")
print(name)
' 2>/dev/null || true
}

# "<backend>\t<funnel>" fuer Port 443, beides leer bzw. "nein", wenn nichts
# eingerichtet ist. Funnel wird mitgelesen, weil es der eine Zustand ist, den
# niemand versehentlich bemerken darf: er stellt den Alarmendpunkt ins
# oeffentliche Internet.
serve_summary() {
  tailscale_cli serve status --json | "$PYTHON" -c '
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    raise SystemExit(1)
backend = ""
funnel = "nein"
for host, entry in sorted((data.get("Web") or {}).items()):
    if not host.endswith(":443"):
        continue
    handler = (entry.get("Handlers") or {}).get("/") or {}
    backend = handler.get("Proxy", "")
    if backend:
        break
if data.get("AllowFunnel"):
    funnel = "ja"
print("{}\t{}".format(backend, funnel))
' 2>/dev/null || true
}

# Die eine Zeile, die wirklich beantwortet, ob ein Alarm ankaeme: eine echte
# HTTPS-Anfrage von aussen an den eigenen Knotennamen, ueber Serve, bis zum
# antwortenden Listener. TLS, Zertifikat, Weiterleitung und Listener haengen
# alle daran. Ausgabe ist der HTTP-Code, "000" wenn keine Antwort kam.
https_probe() {
  curl -sS --max-time 8 -o /dev/null -w '%{http_code}' "https://$1$HEALTH_PATH" 2>/dev/null || true
}

# --- Aktionen ----------------------------------------------------------------

# launchctl bootout kehrt zurueck, sobald launchd den Abbau *angestossen* hat —
# nicht, wenn er fertig ist. Ein bootstrap, das direkt danach kommt, trifft
# deshalb gelegentlich noch auf den alten Dienst und scheitert mit
# "5: Input/output error". Das sieht aus wie Aberglaube, ist aber reproduzierbar:
# genau dieses Wettrennen hat "apager install" gegen einen bereits geladenen
# Agenten scheitern und den Listener unten liegen lassen. Deshalb erst
# abwarten, bis "launchctl print" den Dienst nicht mehr findet, mit einer
# Zeitschranke statt eines geschaetzten festen sleep — ein regulaerer Abbau ist
# in Bruchteilen einer Sekunde durch, mehr als die paar Sekunden hier braucht
# nur ein Dienst, der ohnehin haengt.
wait_bootout() {
  local deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)); do
    launchctl print "$SERVICE" >/dev/null 2>&1 || return 0
    sleep 0.2
  done
  return 1
}

do_install() {
  [[ -f "$LISTENER" ]] || die "apager-listener.py fehlt neben $0"

  mkdir -p "$CONFIG_DIR" "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  if [[ -f "$CONFIG" ]]; then
    printf 'Config bleibt: %s\n' "$CONFIG"
  else
    local token
    token="$(openssl rand -hex 16)"
    # umask in einer Subshell: sonst erbte die plist weiter unten sie und
    # bekaeme bei einer Neuinstallation eine andere Zugriffsmaske als bei der
    # ersten. Das chmod deckt den kurzen Moment zwischen Anlegen und Setzen ab.
    (
      umask 077
      cat > "$CONFIG" <<CONF
# Von \`apager install\` erzeugt. Siehe docs/apager.conf.example.
APAGER_PORT="8787"
APAGER_TOKEN="$token"
CONF
    )
    chmod 600 "$CONFIG"
    printf 'Config angelegt: %s\n' "$CONFIG"
  fi

  # launchd oeffnet die listener.log selbst und mit seiner eigenen umask (644).
  # Die umask des Listeners kommt dafuer zu spaet — die Datei existiert dann
  # schon. Sie enthaelt die abgewiesenen Pfade und damit versuchte Token,
  # deshalb hier anlegen, bevor launchd sie zum ersten Mal oeffnet.
  : >> "$LISTENER_LOG"
  chmod 600 "$LISTENER_LOG"
  # Einsatzadressen, mitunter Namen. Bestandsdateien einer aelteren Fassung
  # tragen noch 644.
  if [[ -f "$ALARM_LOG" ]]; then chmod 600 "$ALARM_LOG"; fi

  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$PYTHON</string>
		<string>$LISTENER</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>$LISTENER_LOG</string>
	<key>StandardErrorPath</key>
	<string>$LISTENER_LOG</string>
</dict>
</plist>
PLIST_EOF

  # bootout vor bootstrap: eine bereits geladene Fassung wuerde die neue sonst
  # mit "service already loaded" abweisen. wait_bootout siehe oben — ohne sie
  # trifft das bootstrap unten manchmal noch auf den alten Dienst.
  launchctl bootout "$SERVICE" 2>/dev/null || true
  if ! wait_bootout; then
    die "alter Dienst geht nicht herunter, vermutlich laeuft er noch mit der alten Config weiter. Kein bootstrap versucht, um ihn nicht zu gefaehrden. Pruefen mit 'apager status', dann 'apager install' erneut versuchen."
  fi

  local bootstrap_err=""
  bootstrap_err="$(launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>&1)" || true
  if launchctl print "$SERVICE" >/dev/null 2>&1; then
    printf 'LaunchAgent geladen: %s\n\n' "$LABEL"
  else
    # Genau der Fall, vor dem dieses Skript warnen soll: der alte Dienst ist
    # weg, der neue kam nicht hoch. Kein Listener laeuft — ein Alarm in diesem
    # Fenster geht verloren. launchd's eigene Fehlermeldung ("Input/output
    # error") nennt keine Ursache, deshalb steht sie hier nur als Zusatz, nicht
    # als letztes Wort.
    die "LaunchAgent NICHT geladen — kein Listener laeuft, Alarme kommen gerade nicht an. launchd: ${bootstrap_err:-Dienst nach bootstrap nicht auffindbar}. Sofort erneut versuchen: apager install"
  fi

  install_serve

  do_url
}

# Serve gehoert zur Installation, nicht daneben: ein Listener ohne Serve davor
# bekommt nichts zu sehen, weil aPager kein Klartext-HTTP absetzen kann. Wer
# nur den LaunchAgent laedt, hat einen Dienst, der laeuft und nie etwas
# empfaengt — genau das Fehlerbild, gegen das dieses Werkzeug gebaut ist.
install_serve() {
  local port
  port="$(config_value APAGER_PORT)" || true
  [[ -n "$port" ]] || port="$DEFAULT_PORT"

  if [[ ! -x "$TAILSCALE" ]]; then
    printf 'ACHTUNG: %s fehlt — Tailscale Serve NICHT eingerichtet.\n' "$TAILSCALE"
    printf '         Ohne Serve nimmt niemand HTTPS an, und etwas anderes kann aPager nicht.\n\n'
    return
  fi

  # --bg, weil serve sonst im Vordergrund bliebe und die Konfiguration mit dem
  # Ende des Befehls wieder verschwaende. --https=443 und nie funnel: der
  # Endpunkt bleibt im Tailnet.
  if tailscale_cli serve --bg --https=443 "http://$LISTEN_ADDRESS:$port" >/dev/null; then
    printf 'Tailscale Serve: HTTPS/443 -> http://%s:%s (nur Tailnet, kein Funnel)\n\n' \
      "$LISTEN_ADDRESS" "$port"
  else
    printf 'ACHTUNG: "tailscale serve" fehlgeschlagen — HTTPS-Anfragen erreichen niemanden.\n'
    printf '         Von Hand pruefen: %s serve status\n\n' "$TAILSCALE"
  fi
}

do_uninstall() {
  launchctl bootout "$SERVICE" 2>/dev/null || true
  rm -f "$PLIST"
  # Sonst bliebe ein Proxy stehen, der auf einen Port zeigt, an dem nichts mehr
  # horcht: HTTPS-Anfragen liefen weiter ins Leere statt sichtbar zu scheitern.
  if [[ -x "$TAILSCALE" ]]; then
    tailscale_cli serve --https=443 off >/dev/null || \
      printf 'Hinweis: "tailscale serve --https=443 off" schlug fehl, Serve steht moeglicherweise noch.\n'
  fi
  printf 'LaunchAgent und Tailscale Serve entfernt. Config und Protokolle bleiben:\n  %s\n  %s\n' \
    "$CONFIG" "$ALARM_LOG"
}

do_url() {
  local token dns
  token="$(config_value APAGER_TOKEN)" || die "keine Config — erst 'apager install'"
  [[ -n "$token" ]] || die "APAGER_TOKEN fehlt in $CONFIG"
  dns="$(tailscale_dns_name)"

  if [[ -n "$dns" ]]; then
    printf 'In aPager als Ziel eintragen:\n\n  https://%s/alarm/%s\n\n' "$dns" "$token"
  else
    # Lieber die Platzhalterform als eine halb echte URL: eine URL, die richtig
    # aussieht und den falschen Knoten nennt, ist schlimmer als sichtbar keine.
    printf 'Der Knotenname ist gerade nicht zu ermitteln (Tailscale aus, oder %s fehlt).\n' \
      "$TAILSCALE"
    printf 'Sobald Tailscale laeuft, lautet die URL:\n\n  https://<knoten>.<tailnet>.ts.net/alarm/%s\n\n' \
      "$token"
  fi
  printf 'HTTPS ist Pflicht, keine Vorsichtsmassnahme: iOS App Transport Security\n'
  printf 'laesst "http://" gar nicht erst zu (NSURLErrorDomain Code=-1022).\n'
  printf 'Das Token ist ein Geheimnis: Wer die URL hat, kann Alarme einspeisen.\n'
}

do_status() {
  local bound

  if launchctl print "$SERVICE" >/dev/null 2>&1; then
    printf 'LaunchAgent   geladen (%s)\n' "$LABEL"
  else
    printf 'LaunchAgent   NICHT geladen — "apager install" fehlt\n'
  fi

  bound="$(bound_address)"
  if [[ -z "$bound" ]]; then
    printf 'Listener      an keine Adresse gebunden\n'
    local why
    why="$(listener_last_line)"
    if [[ -n "$why" ]]; then
      printf '              zuletzt im Protokoll: %s\n' "$why"
    fi
  elif listener_alive "$bound"; then
    printf 'Listener      gebunden an %s\n' "$bound"
  else
    printf 'Listener      veraltete Datei (%s) — es antwortet niemand\n' "$bound"
  fi

  status_serve
  status_https

  # Diagnose, nicht Urteil: die HTTPS-Zeile darueber ist die Aussage. Diese
  # hier sagt, woran es liegt, wenn jene rot ist.
  local ts
  ts="$(tailscale_address)"
  if [[ -n "$ts" ]]; then
    printf 'Tailscale     verbunden (%s)\n' "$ts"
  else
    printf 'Tailscale     keine Adresse — es kommt nichts an\n'
  fi

  if [[ -s "$ALARM_LOG" ]]; then
    local last
    # Kein Treffer ist kein Skriptabbruch wert: eine Datei mit Inhalt, aber
    # ohne passende Zeile (abgebrochener Schreibvorgang, verirrte Zeile vor
    # dem ersten Block), ist ein Anzeigefall, kein Fehlerfall.
    last="$(grep -a '^===== ' "$ALARM_LOG" | tail -1 | tr -d '= ')" || true
    if [[ -n "$last" ]]; then
      printf 'Letzter Alarm %s\n' "$last"
    else
      printf 'Letzter Alarm kein passender Eintrag im Protokoll\n'
    fi
  else
    printf 'Letzter Alarm noch keiner\n'
  fi

  local rejected
  rejected="$(rejection_summary)"
  if [[ -n "$rejected" ]]; then
    printf 'Abgewiesen    %s\n' "$rejected"
  elif [[ -f "$LISTENER_LOG" ]]; then
    printf 'Abgewiesen    keine\n'
  else
    printf 'Abgewiesen    kein Protokoll (%s)\n' "$LISTENER_LOG"
  fi
}

# Zeigt Serve auf den Listener? Ein gebundener Listener ohne Serve davor
# empfaengt nichts, und ein Serve auf das falsche Backend ebenso wenig — beides
# saehe ohne diese Zeile aus wie ein gesunder Aufbau.
status_serve() {
  if [[ ! -x "$TAILSCALE" ]]; then
    printf 'Serve         unbekannt — %s fehlt, nicht gefragt\n' "$TAILSCALE"
    return
  fi

  local summary backend funnel port want
  summary="$(serve_summary)"
  backend="${summary%%$'\t'*}"
  funnel="${summary#*$'\t'}"
  port="$(config_value APAGER_PORT)" || true
  [[ -n "$port" ]] || port="$DEFAULT_PORT"
  want="http://$LISTEN_ADDRESS:$port"

  if [[ -z "$summary" ]]; then
    printf 'Serve         unbekannt — tailscale antwortet nicht\n'
  elif [[ -z "$backend" ]]; then
    printf 'Serve         nicht eingerichtet — HTTPS erreicht niemanden ("apager install")\n'
  elif [[ "$backend" != "$want" ]]; then
    # Der Fall, der das hier ueberhaupt noetig gemacht hat: ein Backend auf der
    # eigenen Tailnet-Adresse laeuft zurueck durch den Tailscale-Stack und
    # blockiert, waehrend alles andere gruen bleibt.
    printf 'Serve         zeigt auf %s, erwartet %s\n' "$backend" "$want"
  else
    printf 'Serve         HTTPS/443 -> %s\n' "$backend"
  fi

  if [[ "$funnel" == "ja" ]]; then
    printf 'Serve         WARNUNG: Funnel ist an — der Alarmendpunkt steht im Internet.\n'
    printf '              Abschalten: %s funnel --https=443 off\n' "$TAILSCALE"
  fi
}

# Die einzige Zeile, die die ganze Kette wirklich anfasst: TLS, Zertifikat,
# Serve, Weiterleitung, antwortender Listener. Alles darueber kann gruen sein,
# waehrend hier nichts durchkommt.
status_https() {
  local dns code
  dns="$(tailscale_dns_name)"
  if [[ -z "$dns" ]]; then
    printf 'HTTPS         unbekannt — Knotenname nicht zu ermitteln, nicht geprueft\n'
    return
  fi

  code="$(https_probe "$dns")"
  case "$code" in
    204) printf 'HTTPS         %s antwortet — ein Alarm kaeme an\n' "$dns" ;;
    000|"") printf 'HTTPS         keine Antwort von %s — aPager erreicht den Mac nicht\n' "$dns" ;;
    404) printf 'HTTPS         %s antwortet mit 404 — dort horcht ein aelterer Listener\n' "$dns" ;;
    *)   printf 'HTTPS         %s antwortet mit %s statt 204 — dort horcht etwas anderes\n' "$dns" "$code" ;;
  esac
}

do_test() {
  local bound token dns
  # Zwei Stufen, und die Reihenfolge ist der Punkt: erst ueber Loopback, ob der
  # Listener ueberhaupt lebt, dann ueber HTTPS den Weg, den aPager nimmt.
  # Scheitert die zweite Stufe nach einer gelungenen ersten, liegt es an Serve
  # oder Tailscale und nicht am Listener — ein Test, der nur eine Zahl liefert,
  # liesse genau diese Unterscheidung offen.
  bound="$(bound_address)"
  [[ -n "$bound" ]] || die "der Listener haengt an keiner Adresse — 'apager status' zeigt warum"
  listener_alive "$bound" \
    || die "veraltete Datei ($bound) — der Listener antwortet nicht, 'apager status' zeigt warum"
  token="$(config_value APAGER_TOKEN)" || die "keine Config — erst 'apager install'"
  [[ -n "$token" ]] || die "APAGER_TOKEN fehlt in $CONFIG"
  dns="$(tailscale_dns_name)"
  [[ -n "$dns" ]] || die "Knotenname nicht zu ermitteln (Tailscale aus?) — 'apager status' zeigt mehr"

  local body
  body="TESTALARM $(date '+%H:%M:%S')
Musterstrasse 12, Musterstadt
Ausgeloest von: apager test"

  printf 'Sende an https://%s/alarm/...\n' "$dns"
  # -K - liest die URL (und damit das Token) aus einem Config-Stream auf
  # stdin statt als Kommandozeilenargument: als Argument stuende es fuer die
  # Laufzeit des Aufrufs in "ps" sichtbar fuer jeden Prozess auf der Maschine
  # — genau das verbietet CLAUDE.md fuer Geheimnisse.
  curl -fsS --max-time 10 -X POST --data-binary "$body" -K - >/dev/null <<CURLCFG \
    || die "ueber HTTPS kam nichts an, obwohl der Listener auf $bound antwortet — also Serve oder Tailscale. 'apager status' zeigt welches von beiden"
url = "https://$dns/alarm/$token"
CURLCFG
  printf 'Angenommen. Der Dialog sollte jetzt offen sein.\n'
}

# Zwei Protokolle, zwei Fragen: alarms.log sagt, was ankam, listener.log sagt,
# was abgewiesen wurde und warum nicht gebunden wird. Letzteres war bisher von
# keinem Befehl erreichbar.
do_logs() {
  local log="$ALARM_LOG" follow=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      --listener)  log="$LISTENER_LOG" ;;
      "")          ;;
      *)           die "unbekannte Option fuer logs: $1 (siehe --help)" ;;
    esac
    shift
  done

  [[ -f "$log" ]] || die "noch kein Protokoll: $log"
  if [[ -n "$follow" ]]; then
    tail -f "$log"
  else
    tail -40 "$log"
  fi
}

case "${1:-}" in
  -h|--help|help) usage ;;
  install)        do_install ;;
  uninstall)      do_uninstall ;;
  status)         do_status ;;
  url)            do_url ;;
  test)           do_test ;;
  logs)           shift; do_logs "$@" ;;
  "")             do_status ;;
  *)              die "unbekannter Befehl: $1 (siehe --help)" ;;
esac
