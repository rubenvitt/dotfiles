#!/usr/bin/env bash
# sbar - Bar (mbar) neu laden und prüfen, dass die Config wirklich durchlief
set -euo pipefail

# Warum es dieses Skript gibt: `--reload` sagt nie, ob die Config durchlief.
# Bricht sie ab, läuft die Bar mit den Werkseinstellungen weiter (Höhe 25,
# keine Items) und nur das Log verrät es. Seit dem Umstieg von SketchyBar auf
# mbar läuft die Lua-Config im Daemon selbst; "gesund" heißt deshalb nur noch:
# `--query bar` liefert Items. Einen eigenen Lua-Prozess, der hängen könnte,
# gibt es nicht mehr.

LABEL="dev.rubeen.mbar"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SERVICE="gui/$(id -u)/$LABEL"
LOG="$HOME/Library/Logs/mbar.log"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar"

# Die Config ist normalerweise in unter einer Sekunde drin. Unter hoher Last
# dauerte sie bei SketchyBar ein Vielfaches (gemessen 40 s bei load 28), daher
# bleibt der Puffer großzügig.
WAIT_SECONDS=45
ATTEMPTS=2

usage() {
  cat <<'EOF'
sbar - Bar (mbar) neu laden und prüfen, dass die Config wirklich durchlief

  sbar                Config neu laden, verifizieren, im Fehlerfall nachlegen
  sbar reload         dasselbe, ausgeschrieben
  sbar restart        echter Prozess-Neustart über launchd + Prüfung
  sbar status         Was läuft gerade: Items, Event-Provider, Warnungen
  sbar -h | --help    diese Hilfe

Ein Prozess-Neustart ist nur nötig, wenn eine per `launchctl setenv` gesetzte
Variable ankommen soll oder ein neues mbar-Binary installiert wurde —
`--reload` liest weder die launchd-Umgebung noch das Binary neu.
EOF
}

die() { printf 'sbar: %s\n' "$1" >&2; exit 1; }

# --- Zustand abfragen --------------------------------------------------------

# Der mbar-Client wartet selbst höchstens 5 s; das äußere timeout fängt nur
# den Fall ab, dass schon der Verbindungsaufbau hängt.
query_bar() { timeout 7 mbar --query bar 2>/dev/null || true; }

item_count() {
  local out
  out="$(query_bar)"
  [[ -z "$out" ]] && { echo -1; return; }
  printf '%s' "$out" | jq -r '.items | length' 2>/dev/null || echo -1
}

healthy() {
  [[ "$(item_count)" -gt 0 ]]
}

wait_healthy() {
  local deadline=$((SECONDS + WAIT_SECONDS))
  while ((SECONDS < deadline)); do
    healthy && return 0
    sleep 0.2
  done
  return 1
}

# Warnungen und Fehler aus dem Log: ein Lua-Fehler in einem Item lässt die
# übrigen Items stehen, die Bar sieht also trotzdem gesund aus.
recent_problems() {
  [[ -f "$LOG" ]] || return 0
  tail -n 200 "$LOG" | grep -E ' (WARN|ERROR) |\[!\]' | tail -n "${1:-5}" || true
}

# --- Aktionen ----------------------------------------------------------------

do_reload() {
  local attempt
  for ((attempt = 1; attempt <= ATTEMPTS; attempt++)); do
    mbar --reload
    if wait_healthy; then
      printf 'sbar: geladen (%s Items, Versuch %d)\n' "$(item_count)" "$attempt"
      return 0
    fi
    printf 'sbar: Versuch %d hängt (>%ds), neuer Anlauf ...\n' "$attempt" "$WAIT_SECONDS" >&2
  done

  printf 'sbar: nach %d Versuchen keine Config in der Bar.\n' "$ATTEMPTS" >&2
  do_status >&2
  return 1
}

do_restart() {
  [[ -f "$PLIST" ]] || die "kein launchd-Plist unter $PLIST — make install-agent im mbar-Repo"

  if launchctl print "$SERVICE" >/dev/null 2>&1; then
    launchctl kickstart -k "$SERVICE"
  else
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
  fi

  if wait_healthy; then
    printf 'sbar: neu gestartet (%s Items)\n' "$(item_count)"
    return 0
  fi
  printf 'sbar: Prozess läuft, aber die Config kam nicht durch — versuche: sbar reload.\n' >&2
  do_status >&2
  return 1
}

do_status() {
  local n

  printf 'mbar         '
  if pgrep -x mbar >/dev/null; then
    printf 'läuft (PID %s)\n' "$(pgrep -x mbar | head -1)"
  else
    printf 'läuft nicht — sbar restart\n'
  fi

  n="$(item_count)"
  printf 'Items        '
  case "$n" in
    -1) printf 'keine Antwort (--query blockiert)\n' ;;
     0) printf '0 — Werkseinstellungen, Config ist nicht durchgelaufen\n' ;;
     *) printf '%s\n' "$n" ;;
  esac

  printf 'Provider     '
  local providers
  providers="$(pgrep -lf 'event_providers/.*/bin/' 2>/dev/null | sed 's|.*/bin/||; s| .*||' | sort -u | tr '\n' ' ')"
  printf '%s\n' "${providers:-keine}"

  printf 'Config-Dir   %s\n' "$CONFIG_DIR"

  local load
  load="$(sysctl -n vm.loadavg | awk '{print $2}')"
  printf 'Systemlast   %s' "$load"
  awk -v l="$load" 'BEGIN { if (l+0 > 12) printf "  (hoch — ein zäher Reload liegt eher daran als an der Config)" }'
  printf '\n'

  local problems
  problems="$(recent_problems 5)"
  if [[ -n "$problems" ]]; then
    printf 'Log          letzte Warnungen aus %s:\n' "$LOG"
    printf '%s\n' "$problems" | sed 's/^/             /'
  fi
}

# --- Einstieg ----------------------------------------------------------------

command -v mbar >/dev/null || die "mbar nicht im PATH (~/.local/bin)"
command -v jq >/dev/null || die "jq nicht im PATH (brew install jq)"
command -v timeout >/dev/null || die "timeout nicht im PATH (brew install coreutils)"

case "${1:-reload}" in
  reload)          do_reload ;;
  restart)         do_restart ;;
  status)          do_status ;;
  -h|--help|help)  usage ;;
  *)               usage >&2; exit 1 ;;
esac
